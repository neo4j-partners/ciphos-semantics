# CIPHOS CSV graph import configuration.
# Copy to .env and supply the Neo4j password. Never commit .env.

# The importer reads node and relationship CSVs from this directory.
CIPHOS_DATA_DIR=ciphos_data/csv
IMPORT_BATCH_SIZE=1000

# Databricks lakehouse target for `make lakehouse-tables`.
# The catalog, schema, and volume default to the values below and may be
# overridden when a different target is needed.
DATABRICKS_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>
CIPHOS_CATALOG=graph-on-databricks
CIPHOS_SCHEMA=ciphos-semantics
CIPHOS_VOLUME=ciphos-raw

# Optional deterministic source batch ID. Leave unset to derive it from the
# complete source manifest and file checksums.
# CIPHOS_BATCH_ID=ciphos-...

# Seconds to wait for one lakehouse SQL statement before cancelling it.
# CIPHOS_STATEMENT_TIMEOUT_SECONDS=900

# The hybrid demo reads this Delta view. The default schema is CIPHOS_SCHEMA.
# CIPHOS_SILVER_SCHEMA=ciphos-semantics
# CIPHOS_SILVER_PROPERTY_VIEW=graph-on-databricks.ciphos-semantics.silver_tag_property_value_enriched

# Neo4j target. Use neo4j+s:// for Neo4j Aura, or bolt:// for a local server.
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
# NEO4J_DATABASE is the serving database the demo reads. Candidate graph
# builds must target CIPHOS_CANDIDATE_DATABASE, which has to differ from it.
NEO4J_DATABASE=neo4j
# CIPHOS_CANDIDATE_DATABASE=ciphoscandidate

# A graph build consumes a local materialization of an approved Silver snapshot
# and must target an isolated candidate database. These lineage values are
# required by make graph and make graph-activate.
# CIPHOS_SILVER_SNAPSHOT_DIR=/path/to/published-silver-snapshot
# CIPHOS_SOURCE_BATCH_ID=ciphos-...
# CIPHOS_SOURCE_SNAPSHOT_ID=ciphos-...
# CIPHOS_GRAPH_SNAPSHOT_ID=graph-...
# CIPHOS_APPLICATION_REVISION=<git-or-build-revision>
