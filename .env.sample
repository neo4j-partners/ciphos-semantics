# CIPHOS CSV graph import configuration.
# Copy to .env and supply the Neo4j password. Never commit .env.

# The importer reads node and relationship CSVs from this directory.
CIPHOS_DATA_DIR=ciphos_data/csv
IMPORT_BATCH_SIZE=1000

# Databricks lakehouse target for `make lakehouse-tables`.
# The catalog, schema, and volume default to the values below and may be
# overridden when a different target is needed.
DATABRICKS_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>
CIPHOS_CATALOG=graph-on-databricks
CIPHOS_SCHEMA=ciphos-semantics
CIPHOS_VOLUME=ciphos-raw

# Optional deterministic source batch ID. Leave unset to derive it from the
# complete source manifest and file checksums.
# CIPHOS_BATCH_ID=ciphos-...

# Seconds to wait for one lakehouse SQL statement before cancelling it.
# CIPHOS_STATEMENT_TIMEOUT_SECONDS=900

# The hybrid demo reads this Delta view. The default schema is CIPHOS_SCHEMA.
# CIPHOS_SILVER_SCHEMA=ciphos-semantics
# CIPHOS_SILVER_PROPERTY_VIEW=graph-on-databricks.ciphos-semantics.silver_tag_property_value_enriched

# Operational CIPHOS graph. Use neo4j+s:// for Neo4j Aura, or bolt:// for a
# local server. The OPS_ prefix is required: the bare NEO4J_* names below are
# reserved for the NeoCarta semantic store, which NeoCarta reads directly.
OPS_NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
OPS_NEO4J_USERNAME=neo4j
OPS_NEO4J_PASSWORD=<your-neo4j-password>
# OPS_NEO4J_DATABASE is the serving database the demo reads. Candidate graph
# builds must target CIPHOS_CANDIDATE_DATABASE, which has to differ from it.
OPS_NEO4J_DATABASE=neo4j
# CIPHOS_CANDIDATE_DATABASE=ciphoscandidate

# Set this only when deliberately targeting docker-compose.semantic-test.yml.
# The flag replaces Neo4j settings in the running process only; it never edits
# or removes the normal remote values above. `uv run ciphos-local` sets it for
# its own setup, seed, and semantic-store population workflow.
# NEO4J_LOCAL=true
# CIPHOS_TEST_NEO4J_PASSWORD=ciphos-test-password

# NeoCarta semantic store. This holds LPG schema metadata only, never
# operational values. NeoCarta's library and MCP server read these bare names
# directly, so they must never resolve to the operational graph above.
# What has to differ from the operational graph is the URI-and-database pair,
# not the database name on its own. A separate Aura instance is the normal
# arrangement, and there the database is named neo4j on both sides.
# NEO4J_URI=neo4j+s://<your-semantic-instance>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<your-semantic-store-password>
# NEO4J_DATABASE=neo4j

# Optional when the semantic store contains more than one source-scoped CIPHOS
# map. `make semantic-context` and `make semantic-mcp` auto-detect the scope
# when exactly one exists and never read OPS_NEO4J_* to derive it.
# CIPHOS_SEMANTIC_SOURCE_SCOPE=neo4j:<16-hex-source-scope>

# Semantic search indexes metadata for these curated Silver views only. It
# never samples or copies CIPHOS operational values into Neo4j. The default
# covers enriched traceability, row-level source links, publication snapshots,
# and data-quality results.
# CIPHOS_SEMANTIC_TABLES=silver_tag_property_value_enriched,silver_data_quality_results,silver_snapshots,silver_tag_property_value_sources
# CIPHOS_SEMANTIC_EMBEDDING_MODEL=databricks/system.ai.gte-large-en
# CIPHOS_SEMANTIC_LLM_ENDPOINT=<foundation-model-serving-endpoint>
# Optional when the workspace profile already contains these values.
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_SERVER_HOSTNAME=<workspace-host>
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# A graph build consumes a local materialization of an approved Silver snapshot
# and must target an isolated candidate database. These lineage values are
# required by make graph and make graph-activate.
# CIPHOS_SILVER_SNAPSHOT_DIR=/path/to/published-silver-snapshot
# CIPHOS_SOURCE_BATCH_ID=ciphos-...
# CIPHOS_SOURCE_SNAPSHOT_ID=ciphos-...
# CIPHOS_GRAPH_SNAPSHOT_ID=graph-...
# CIPHOS_APPLICATION_REVISION=<git-or-build-revision>
